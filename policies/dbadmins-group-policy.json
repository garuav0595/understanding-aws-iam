{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RDSFullAccessScopedToTaggedResources",
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "rds:ModifyDBInstance",
        "rds:RebootDBInstance",
        "rds:CreateDBSnapshot",
        "rds:RestoreDBInstanceFromDBSnapshot"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Team": "DBAdmins"
        }
      }
    }
  ]
}
